<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ChessApp.ViewModels"
             x:Class="ChessApp.Views.CompetitionView"
             x:DataType="vm:CompetitionViewModel">

    <StackPanel Margin="20" Spacing="10">

        <TextBlock Text="{Binding Name}"
                   FontSize="20"
                   FontWeight="Bold"/>

        <TextBlock>
            <Run Text="Date : "/>
            <Run Text="{Binding Date}"/>
        </TextBlock>

        <TextBlock>
            <Run Text="Lieu : "/>
            <Run Text="{Binding Location}"/>
        </TextBlock>

        <Separator/>

        <TextBlock Text="Joueurs inscrits"
                   FontWeight="Bold"/>

        <ItemsControl ItemsSource="{Binding Players}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <TextBlock>
                        <Run Text="{Binding FirstName}"/>
                        <Run Text=" "/>
                        <Run Text="{Binding LastName}"/>
                    </TextBlock>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Separator/>

        <TextBlock Text="Matchs"
                   FontWeight="Bold"/>

        <ItemsControl ItemsSource="{Binding Matches.Matches}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Result}"/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

    </StackPanel>

</UserControl>
