<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ChessApp.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" 
        d:DesignWidth="800" 
        d:DesignHeight="450"
        x:Class="ChessApp.Views.MainWindow"
        x:DataType="vm:PlayerListViewModel"
        Name="Root"
        Icon="/Assets/avalonia-logo.ico"
        Title="ChessApp">

    <Design.DataContext>
        <vm:PlayerListViewModel/>
    </Design.DataContext>

    <TabControl>
        
        <TabItem Header="Joueur">
            <Grid RowDefinitions="Auto, Auto, *" Margin="10">
                
                <Expander Grid.Row="0" Header="Inscrire un nouveau joueur" Margin="0,0,0,10">
                    <ScrollViewer MaxHeight="350">
                        <StackPanel Margin="10">

                            <TextBlock Text="Prénom:"/>
                            <TextBox Text="{Binding NewPlayerFirstName}" Margin="0,5,0,0"/>

                            <TextBlock Text="Nom:" Margin="0,10,0,0"/>
                            <TextBox Text="{Binding NewPlayerLastName}" Margin="0,5,0,0"/>

                            <TextBlock Text="Email:" Margin="0,10,0,0"/>
                            <TextBox Text="{Binding NewPlayerEmail}" Margin="0,5,0,0">
                                <TextBox.KeyBindings>
                                    <KeyBinding Gesture="Enter" Command="{Binding AddPlayerCommand}" />
                                </TextBox.KeyBindings>
                            </TextBox>
                            
                            <TextBlock Text="Date de naissance:" Margin="0,10,0,0"/>
                            <DatePicker SelectedDate="{Binding NewPlayerBirthDate}" HorizontalAlignment="Stretch" Margin="0,5,0,0"/>
                            
                            <ItemsControl ItemsSource="{Binding CustomFields}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="vm:FieldViewModel">
                                        <StackPanel>
                                            <TextBlock Text="{Binding DisplayName}" Margin="0,10,0,0"/>
                                            <TextBox Text="{Binding Value, Mode=TwoWay}" Margin="0,5,0,0"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            
                            <Button Command="{Binding AddPlayerCommand}" HorizontalAlignment="Stretch" Margin="0,15,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <PathIcon Data="{DynamicResource AcceptIconData}" Foreground="Green" />
                                    <TextBlock Text="Inscrire le joueur" Margin="10,0,0,0"/>
                                </StackPanel>
                            </Button>

                        </StackPanel>
                    </ScrollViewer>
                </Expander>

                <Grid Grid.Row="1" ColumnDefinitions="*, Auto" Margin="0,0,0,10">
                    <TextBox Grid.Column="0"
                             Text="{Binding SearchText, Mode=TwoWay}"
                             Watermark="Rechercher par nom ou prénom..."
                             Margin="0,0,10,0">
                        <TextBox.KeyBindings>
                            <KeyBinding Gesture="Enter" Command="{Binding SearchCommand}" />
                        </TextBox.KeyBindings>
                    </TextBox>

                    <Button Grid.Column="1" 
                            Content="Rechercher" 
                            Command="{Binding SearchCommand}"/>
                </Grid>

                <ListBox Grid.Row="2" ItemsSource="{Binding FilteredPlayers}"
                         BorderThickness="1" BorderBrush="Gray">

                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="vm:PlayerViewModel">
                            <Expander HorizontalAlignment="Stretch">

                                <Expander.Header>
                                    <Grid ColumnDefinitions="*, Auto">
                                        <StackPanel Grid.Column="0">
                                            <TextBlock FontWeight="Bold">
                                                <Run Text="{Binding FirstName}"/> <Run Text="{Binding LastName}"/>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Email}" FontSize="10" Foreground="Gray"/>
                                        </StackPanel>

                                        <Button Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Margin="10,0,0,0"
                                                Command="{Binding #Root.DataContext.RemovePlayerCommand}"
                                                CommandParameter="{Binding .}">
                                            <PathIcon Data="{DynamicResource DeleteIconData}" Height="15" Foreground="Red" />
                                        </Button>
                                    </Grid>
                                </Expander.Header>

                                <StackPanel Margin="15,10,15,10">

                                    <TextBlock Text="Prénom:"/>
                                    <TextBox Text="{Binding FirstName, Mode=TwoWay}" Margin="0,5,0,0"/>

                                    <TextBlock Text="Nom:" Margin="0,10,0,0"/>
                                    <TextBox Text="{Binding LastName, Mode=TwoWay}" Margin="0,5,0,0"/>

                                    <TextBlock Text="Email:" Margin="0,10,0,0"/>
                                    <TextBox Text="{Binding Email, Mode=TwoWay}" Margin="0,5,0,0"/>

                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <TextBlock Text="Né(e) le: " VerticalAlignment="Center"/>
                                        <DatePicker SelectedDate="{Binding BirthDate}" />
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                        <TextBlock Text="Parties jouées: " FontWeight="Bold"/>
                                        <TextBlock Text="{Binding MatchCount}" Margin="5,0,0,0"/>
                                    </StackPanel>

                                    <TextBlock Text="Classements:" FontWeight="Bold" Margin="0,15,0,0"/>
                                    <ItemsControl ItemsSource="{Binding Rankings}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="vm:RankingViewModel">
                                                <Grid ColumnDefinitions="*, *" Margin="0,2">
                                                    <TextBlock Grid.Column="0" Text="{Binding Name}" VerticalAlignment="Center"/>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBox Text="{Binding StringValue, Mode=TwoWay}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <TextBlock Text="Attributs:" FontWeight="Bold" Margin="0,10,0,0"/>
                                    <ItemsControl ItemsSource="{Binding Fields}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="vm:PlayercustomfieldViewModel">
                                                <Grid ColumnDefinitions="*, *" Margin="0,2">
                                                    <TextBlock Grid.Column="0" Text="{Binding DisplayName}" VerticalAlignment="Center"/>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBox Text="{Binding Value, Mode=TwoWay}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    
                                </StackPanel>
                            </Expander>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                
            </Grid>
        </TabItem>

        <TabItem Header="Classement">
            <ContentControl Content="{Binding ClassementVM}" />
        </TabItem>

        <TabItem Header="Compétition">
            <ContentControl Content="{Binding CompetitionList}" />
        </TabItem>

    </TabControl> 
</Window>